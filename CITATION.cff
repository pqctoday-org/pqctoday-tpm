  - name: "PQC Today, LLC"
type: software
version: "0.10.1"
date-released: "2026-10-15"
license: BSD-3-Clause
repository-code: "https://github.com/pqctoday-org/pqctoday-tpm"
keywords:
  - TPM 2.0
  - post-quantum cryptography
  - ML-KEM
  - ML-DSA
  - libtpms
  - swtpm
